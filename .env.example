# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Memorial Robot"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/app

# Uploads (memory photos, videos, audio); sizes are in bytes
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=52428800
MAX_VIDEO_BYTES=209715200
MAX_FILES_PER_UPLOAD=10

# AI extraction (local Ollama + Whisper). In Docker the base URL defaults to the host
# AI_BACKEND=fake replaces the models with canned ones, for end-to-end tests only
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT_SECONDS=300
WHISPER_MODEL=base
MAX_MEDIA_SECONDS=3600
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.45
MIN_EXTRACTION_CONFIDENCE=0.3
PERSONA_STYLE_EXAMPLES=5
PERSONA_HISTORY_TURNS=6
